@startuml


package Model{

    class Image{
        url: String
    }

    class Animation{
        frames: List<Image>
        duration: Int
    }
    class User {
        - pet: Pet
        - goals: List<Goal>
        + addGoal()
        + setPet()
        + isPetHappy(): Boolean
    }
    class UserSettings{
        + petName: String
        + reminders: Boolean
    }

    class Pet {
        + name: String
        + animation: Animation?
        + image: Image
    }
    enum Priority {
        LOW
        MEDIUM
        HIGH
    }

    class Goal {
        + name: String
        + deadline: Date?
        + priority: Priority
        + createdAt: Date
        + doneAt: Date?
        + isDone(): Boolean
        + markAsDone()
    }
    Goal o- Priority
    User *-- Pet
    User *-- Goal
    User *-- UserSettings
    Pet o-- Image
    Pet o-- Animation
    Animation o-- Image

}

package View{
    class InitialLoginView{
    }

    class HomeView {
    }

    class SettingsView{
    }
}

package ViewModel{
    class InitialLoginViewModel{
        login()
        user: User
        pets: List<Pet>
    }
    class HomeViewModel {
        addGoal()
        markGoalDone()
        user: User
    }
    class SettingsViewModel{
        userSettings: UserSettings
        saveSettings()
    }
}

package Repository{
    class UserRepository {
        getUser()
        saveUser()
    }

    class GoalRepository {
        getGoals()
        saveGoal()
        updateGoal()
    }
    class PetRepository{
        getAll()
    }
}

InitialLoginView -down-> InitialLoginViewModel
HomeView -down-> HomeViewModel
SettingsView -down-> SettingsViewModel

InitialLoginViewModel -down--> UserRepository
InitialLoginViewModel -down--> PetRepository

HomeViewModel -down> GoalRepository
HomeViewModel -down> UserRepository

SettingsViewModel -down-> UserRepository


PetRepository --> Pet
UserRepository --> User
GoalRepository --> Goal
@enduml